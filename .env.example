# Copy to .env.local to override locally. Every variable is validated at startup
# (src/config/env.ts); an invalid value shows a "misconfigured" page, not a blank screen.

# Origin of the DocTayo API: scheme + host (+ port). No path, no trailing slash.
VITE_API_ORIGIN=http://localhost:3000

# development | staging | production
VITE_APP_ENV=development

# Optional. Error reporting is added in Phase 14; leave empty until then.
VITE_ERROR_REPORTING_DSN=
